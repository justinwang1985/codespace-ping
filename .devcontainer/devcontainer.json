{
  "name": "codespace-ping",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "forwardPorts": [3737],
  "portsAttributes": {
    "3737": {
      "label": "codespace-ping notifier",
      "onAutoForward": "openPreview",
      "visibility": "private"
    }
  },
  "postCreateCommand": "chmod +x bin/ping-done bin/ping-server && echo 'export PATH=\"$PATH:'\"$(pwd)\"'/bin\"' >> ~/.bashrc",
  "postStartCommand": "bash bin/ping-server start"
}